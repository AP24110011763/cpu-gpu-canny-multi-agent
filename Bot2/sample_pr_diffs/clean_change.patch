+"""Mathematical utilities module providing safe operations."""
+
+from typing import Sequence
+
+
+def calculate_average(numbers: Sequence[float]) -> float:
+    """Calculates the arithmetic mean of a sequence of numbers."""
+    if not numbers:
+        raise ValueError("Cannot calculate average of an empty sequence.")
+    return sum(numbers) / len(numbers)
